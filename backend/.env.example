ENVIRONMENT=local

# Set these to an existing Hopsworks project and feature view.
# Hopsworks credentials are only needed when running the feature_snapshot pipeline.
HOPSWORKS_HOST=
HOPSWORKS_PROJECT=
HOPSWORKS_API_KEY=
HOPSWORKS_FEATURE_VIEW=
HOPSWORKS_FEATURE_VIEW_VERSION=1
# Required only when the view has transformations fitted to a training dataset.
# HOPSWORKS_TRAINING_DATASET_VERSION=1
